DATABASE_URL=postgresql://postgres:postgres@localhost:5432/edgefit
DATABASE_SSL=disable
INTERNAL_ACCESS_PASSWORD=change-me
INTERNAL_ACCESS_SECRET=change-me-too
CRON_SECRET=change-me-long-random-string
NEXT_PUBLIC_SITE_URL=https://snowdex.ru
# Unset defaults to Vercel. Docker sets timeweb; public provider is baked at build.
NEXT_PUBLIC_HOSTING_PROVIDER=vercel
SNOWDEX_STANDALONE=false
SNOWDEX_SHADOW_MODE=false
NEXT_PUBLIC_YANDEX_METRIKA_ID=
YANDEX_METRIKA_OAUTH_TOKEN=
ANALYTICS_DELIVERY_ENABLED=false
RESEND_API_KEY=
ANALYTICS_DELIVERY_SENDER=
ANALYTICS_DELIVERY_RECIPIENT=
SAVED_RESULTS_ENABLED=false
